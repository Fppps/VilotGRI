  "Rules": {
    "operator_only_requires_context": true,
    "short_wh_without_concrete_anchor_requires_context": true,
    "deictic_only_requires_context": true,
    "context_window_turns": 12
  },
  "Referent_Inheritance": {
    "pronoun_subject": [
      "it",
      "this",
      "that",
      "these",
      "those",
      "they",
      "them"
    ],
    "previous_subject_reuse": [
      "what about",
      "and",
      "also",
      "then",
      "instead"
    ],
    "previous_relation_reuse": [
      "why",
      "how",
      "where",
      "when",
      "which one",
      "what next"
    ],
    "maximum_turns": 12,
    "prefer_most_recent_concrete_subject": true,
    "do_not_inherit_if_new_concrete_subject_present": true
  },
  "General_Knowledge_Expansion": {
    "Build": "25-system-5",
    "Ellipsis_Pattern_Count": 24
  },
  "Reference_Resolution": {
    "use_reference_rules_dataset": true,
    "preserve_unresolved_references": true,
    "reflexive_same_clause_subject_bias": 0.98,
    "previous_clause_subject_bias": 0.82,
    "conversation_focus_bias": 0.56,
    "maximum_local_clause_distance": 4
  },
  "Complex_Context": {
    "inherit_clause_graph": true,
    "inherit_proposition_graph": true,
    "do_not_replace_explicit_new_subject": true
  }
