  "Explanation_Policy": {
    "why": {
      "roles": [
        "cause",
        "mechanism",
        "effect",
        "relation"
      ],
      "preferred_clause_types": [
        "cause",
        "mechanism",
        "effect",
        "relation"
      ],
      "minimum_clauses": 2
    },
    "how": {
      "roles": [
        "mechanism",
        "composition",
        "capability",
        "part_of",
        "effect"
      ],
      "preferred_clause_types": [
        "mechanism",
        "composition",
        "capability",
        "has_part",
        "effect"
      ],
      "minimum_clauses": 2
    },
    "both": {
      "roles": [
        "cause",
        "mechanism",
        "effect",
        "purpose",
        "relation"
      ],
      "preferred_clause_types": [
        "cause",
        "mechanism",
        "effect",
        "purpose",
        "relation"
      ],
      "minimum_clauses": 3
    }
  },
  "Complex_Requests": {
    "directive_plus_embedded_wh": {
      "examples": [
        "explain how X works",
        "describe why X changes",
        "show what X does"
      ],
      "preserve_directive": true,
      "embedded_wh_controls_requested_role": true
    },
    "conditional_question": {
      "markers": [
        "if",
        "unless",
        "provided that"
      ],
      "preserve_condition": true
    },
    "multi_part_request": {
      "connectors": [
        "and",
        "also",
        "while",
        "but"
      ],
      "preserve_each_requested_role": true
    },
    "comparison_request": {
      "markers": [
        "compare",
        "than",
        "whereas",
        "difference",
        "similar"
      ],
      "require_two_sides": true
    }
  }
